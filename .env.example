# PPT stage (server-side only)
LLM_BASE_URL=https://your-openai-compatible-service/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_OUTLINE_JSON_MODEL=qwen3.8-27b

# Lesson stage (server-side only; same or another OpenAI-compatible endpoint)
JIAOAN_BASE_URL=https://your-openai-compatible-service/v1
JIAOAN_API_KEY=
JIAOAN_MODEL=deepseek-v4-flash
JIAOAN_TIMEOUT=900
JIAOAN_MAX_TOKENS=8192
JIAOAN_MAX_CONTEXT=24000
JIAOAN_DISABLE_THINKING=true


# Scanned PDF OCR (local RapidOCR)
PDF_OCR=1
PDF_OCR_DPI=200


# Scanned PDF engine: auto (prefer the installed parsing service, else RapidOCR) | mineru | rapidocr
PDF_OCR_ENGINE=auto
MINERU_TIER=standard
MINERU_TIMEOUT=1800
# Optional: full command path, e.g. .mineru\Scripts\mineru-kit.exe (Windows)
MINERU_COMMAND=

# Transient hand-off copies are deleted after this many days (0 keeps them)
PIPELINE_RETENTION_DAYS=7

# --- 登录/邮箱验证码（公网部署必填） ---
AUTH_SECRET=                     # 会话签名密钥；留空则自动生成到 data/auth/session-secret.txt
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_SSL=1
AUTH_COOKIE_SECURE=1             # 公网 HTTPS 部署时开启
# AUTH_DEV_CODE=1                # 仅本机调试：直接在响应里返回验证码，公网禁用
